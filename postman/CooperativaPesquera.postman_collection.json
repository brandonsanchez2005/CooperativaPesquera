{
  "info": {
    "_postman_id": "77041dc5-8409-4e90-9e1d-e5f7eaa9b722",
    "name": "CooperativaPesquera API",
    "description": "Colección de pruebas para la API de CooperativaPesquera. Importa y selecciona el environment CooperativaPesquera Local. Completa las credenciales localmente y ejecuta las solicitudes en orden; los scripts guardan los ids y tokens de las respuestas. Para las solicitudes de Consulta, crea primero en Django Admin un usuario y agrégalo al grupo Consulta. No exportes credenciales ni tokens.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "01 - Obtener token de Administrador",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json",
            "type": "text"
          }
        ],
        "url": "{{base_url}}/api/token/",
        "description": "Esperado: 200 OK. Devuelve un token para las solicitudes protegidas. Completa username y password solo en tu environment local; no exportes esos valores.",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"username\": \"{{username}}\",\n  \"password\": \"{{password}}\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Esperado: HTTP 200\", function () { pm.response.to.have.status(200); });",
              "if (pm.response.code === 200) { pm.environment.set(\"token\", pm.response.json().token); }"
            ]
          }
        }
      ],
      "response": []
    },
